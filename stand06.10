<script>
document.documentElement.classList.add('js');
(function(){
var els=document.querySelectorAll('.promises div,ol.steps li,.panel,#home section h2,#agenturen section h2,.tags li');
if(!('IntersectionObserver' in window)){return}
var io=new IntersectionObserver(function(en){en.forEach(function(e){if(e.isIntersecting){var t=e.target;t.classList.add('in');io.unobserve(t);setTimeout(function(){t.style.transitionDelay='';t.classList.remove('rv')},1200)}})},{threshold:.15});
els.forEach(function(el){var i=Array.prototype.indexOf.call(el.parentNode.children,el);el.style.transitionDelay=(i*70)+'ms';el.classList.add('rv');io.observe(el)});
})();
var cur='home';
function show(h){
var legal=h==='impressum'||h==='datenschutz';
var view=legal||h==='agenturen'?h:(h===''||h==='home'||h==='problem'||h==='ablauf'||h==='fuer-wen')?'home':cur;
if(view==='home'||view==='agenturen')cur=view;
['home','agenturen','impressum','datenschutz'].forEach(function(id){document.getElementById(id).hidden=id!==view});
document.getElementById('contact').hidden=legal;
document.querySelectorAll('.switch a').forEach(function(a){a.classList.toggle('on',a.getAttribute('href')==='#'+(view==='agenturen'?'agenturen':'home'))});
var el=h&&document.getElementById(h);
if(legal||h===''||h==='home'||h==='agenturen'||!el){window.scrollTo(0,0)}else{el.scrollIntoView()}
}
function route(){show(location.hash.slice(1))}
document.addEventListener('click',function(e){
var a=e.target.closest&&e.target.closest('a[href^="#"]');if(!a)return;
var h=a.getAttribute('href').slice(1);if(!h)return;
e.preventDefault();try{history.replaceState(null,'','#'+h)}catch(x){}show(h)});
var btn=document.getElementById('menuBtn'),nav=document.getElementById('nav');
function setMenu(o){nav.classList.toggle('open',o);btn.setAttribute('aria-expanded',o)}
btn.addEventListener('click',function(){setMenu(!nav.classList.contains('open'))});
nav.addEventListener('click',function(e){if(e.target.tagName==='A')setMenu(false)});
var cb=document.getElementById('copyBtn'),cm=document.getElementById('copyMsg'),addr='jt-digital@web.de';
function copied(ok){cm.textContent=ok?'Adresse kopiert: '+addr:'Bitte Adresse manuell kopieren: '+addr}
cb.addEventListener('click',function(){
if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(addr).then(function(){copied(true)},fallback)}else{fallback()}
function fallback(){try{var t=document.createElement('textarea');t.value=addr;t.style.position='fixed';t.style.opacity='0';document.body.appendChild(t);t.select();var ok=document.execCommand('copy');document.body.removeChild(t);copied(ok)}catch(e){copied(false)}}
});
document.getElementById('mailBtn').addEventListener('click',function(){cm.textContent='Öffnet sich kein Mailprogramm? Nutze „Adresse kopieren“ oder schreibe an '+addr+'.'});
window.addEventListener('hashchange',route);
route();
</script>
</body>
</html>
